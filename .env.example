# Add these as server-side variables in Vercel (never NEXT_PUBLIC_).
# Supabase project URL, for example https://xxxxx.supabase.co
SUPABASE_URL=
# Supabase service_role secret. Keep this server-only.
SUPABASE_SERVICE_ROLE_KEY=
# A long secret code shared only with trusted field-testers who can create layers.
LAYERX_CREATE_ACCESS_CODE=
